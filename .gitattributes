###############################################################################
# Set default behavior to automatically normalize line endings.
# text=auto: Git handles conversion (LF in repo, OS-native in working copy)
###############################################################################
* text=auto

# Force LF for code and scripts (crucial for Linux/LÖVE)
*.lua text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.exe binary

# Image files are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Data files: prioritize upstream version during rebase
src/Data/ModCache.lua merge=ours
src/Data/Uniques/*.lua merge=ours
src/Data/Gems/*.lua merge=ours

# Preserve execution permissions
runtime/*.exe binary
love/launcher/launcher binary
